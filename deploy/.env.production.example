APP_NAME="EverGrove"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ever-grove.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/evergrove/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=ever-grove.co.uk
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USERNAME="info@ever-grove.co.uk"
MAIL_PASSWORD=""
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@ever-grove.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

COMPANY_NAME="EverGrove Retail Ltd"
COMPANY_NUMBER="14892341"
COMPANY_ADDRESS="71-75 Shelton Street, Covent Garden, London, WC2H 9JQ, United Kingdom"
COMPANY_EMAIL="info@ever-grove.co.uk"

VITE_APP_NAME="${APP_NAME}"
